{"id": "calculator_basic", "prompt": "Calculate sqrt(144) + 1 using the calculator tool.", "steps": [{"tool": "calculator", "arguments": {"expression": "sqrt(144) + 1"}}], "expected_substrings": ["13"]}
{"id": "calculator_discount", "prompt": "用计算器算一下：299 打 8 折再减 20 等于多少？", "steps": [{"tool": "calculator", "arguments": {"expression": "299 * 0.8 - 20"}}], "expected_substrings": ["219.2"]}
{"id": "calculator_error_surfaced", "prompt": "用计算器算 1/0，看看会怎样。", "steps": [{"tool": "calculator", "arguments": {"expression": "1/0"}}], "expected_substrings": ["Error"]}
{"id": "python_fibonacci", "prompt": "Use Python to print the first five Fibonacci numbers.", "steps": [{"tool": "execute_python", "arguments": {"code": "a, b = 0, 1\nseq = []\nfor _ in range(5):\n    seq.append(a)\n    a, b = b, a + b\nprint(seq)"}}], "expected_substrings": ["[0, 1, 1, 2, 3]"]}
{"id": "python_word_count", "prompt": "用 Python 统计字符串 'nanogent is a small agent runtime' 有几个单词。", "steps": [{"tool": "execute_python", "arguments": {"code": "print(len('nanogent is a small agent runtime'.split()))"}}], "expected_substrings": ["6"]}
{"id": "read_file_config", "prompt": "读取 evals/fixtures/config.json，告诉我服务端口是多少。", "steps": [{"tool": "read_file", "arguments": {"path": "evals/fixtures/config.json"}}], "expected_substrings": ["8080"]}
{"id": "read_file_sample", "prompt": "看看 evals/fixtures/sample.py 里有什么待办事项。", "steps": [{"tool": "read_file", "arguments": {"path": "evals/fixtures/sample.py"}}], "expected_substrings": ["TODO"]}
{"id": "read_file_missing", "prompt": "读一下 evals/fixtures/does_not_exist.txt。", "steps": [{"tool": "read_file", "arguments": {"path": "evals/fixtures/does_not_exist.txt"}}], "expected_substrings": ["not found"]}
{"id": "grep_todo", "prompt": "在 evals/fixtures 目录里搜索 TODO。", "steps": [{"tool": "grep", "arguments": {"pattern": "TODO", "path": "evals/fixtures"}}], "expected_substrings": ["TODO"]}
{"id": "grep_include_filter", "prompt": "只在 Python 文件里搜索 def（路径 evals/fixtures）。", "steps": [{"tool": "grep", "arguments": {"pattern": "def ", "path": "evals/fixtures", "include": "*.py"}}], "expected_substrings": ["sample.py"]}
{"id": "grep_no_match", "prompt": "在 evals/fixtures 里搜索 NEEDLE_NOT_EXIST。", "steps": [{"tool": "grep", "arguments": {"pattern": "NEEDLE_NOT_EXIST", "path": "evals/fixtures"}}], "expected_substrings": ["No matches"]}
{"id": "glob_python_files", "prompt": "列出 evals/fixtures 下所有 Python 文件。", "steps": [{"tool": "glob", "arguments": {"pattern": "**/*.py", "path": "evals/fixtures"}}], "expected_substrings": ["sample.py"]}
{"id": "glob_all_files", "prompt": "列出 evals/fixtures 下的全部文件。", "steps": [{"tool": "glob", "arguments": {"pattern": "**/*", "path": "evals/fixtures"}}], "expected_substrings": ["config.json"]}
{"id": "write_file_report", "prompt": "把 hello nanogent 写入 evals/fixtures/generated/report.txt。", "steps": [{"tool": "write_file", "arguments": {"path": "evals/fixtures/generated/report.txt", "content": "hello nanogent"}}], "expected_substrings": ["successfully"]}
{"id": "write_file_then_read_back", "prompt": "写入 evals/fixtures/generated/roundtrip.txt 内容为 nanogent roundtrip，然后读回来确认。", "steps": [{"tool": "write_file", "arguments": {"path": "evals/fixtures/generated/roundtrip.txt", "content": "nanogent roundtrip"}}, {"tool": "read_file", "arguments": {"path": "evals/fixtures/generated/roundtrip.txt"}}], "expected_substrings": ["nanogent roundtrip"]}
{"id": "multi_step_read_then_write", "prompt": "读取 evals/fixtures/config.json，然后把端口号写进 evals/fixtures/generated/port.txt。", "steps": [{"tool": "read_file", "arguments": {"path": "evals/fixtures/config.json"}}, {"tool": "write_file", "arguments": {"path": "evals/fixtures/generated/port.txt", "content": "8080"}}], "expected_substrings": ["successfully"]}
{"id": "multi_step_grep_then_read", "prompt": "先在 evals/fixtures 里搜索 TODO，然后读取命中的文件。", "steps": [{"tool": "grep", "arguments": {"pattern": "TODO", "path": "evals/fixtures"}}, {"tool": "read_file", "arguments": {"path": "evals/fixtures/sample.py"}}], "expected_substrings": ["TODO"]}
{"id": "web_search_basic", "prompt": "搜索一下 nanogent 这个项目是什么。", "steps": [{"tool": "web_search", "arguments": {"query": "nanogent agent runtime"}}], "expected_substrings": ["Simulated search"]}
{"id": "no_tool_needed", "prompt": "用一句话解释什么是接口幂等，不需要调用任何工具。", "steps": [], "forbidden_tools": ["calculator", "execute_python", "read_file", "write_file", "glob", "grep", "web_search"]}
